{
  "depth": 3,
  "max_epochs_per_layer": 3,
  "max_epochs_end_to_end": 3,
  "early_stopping_patience": 2,
  "batch_size": 64,
  "learning_rate": 0.0002,
  "layerwise_learning_rate": 0.0002,
  "finetune_lr_factors": [0.2, 0.02],
  "older_layer_gradient_decay": 1.0,
  "seed": 0,
  "salista": {
    "cell": "gru",
    "sharing": "shared",
    "hidden_size": 32,
    "gamma_min": 0.5,
    "gamma_max": 1.1,
    "beta_max": 0.2,
    "eta": 0.05,
    "stall_threshold_ratio": 0.8,
    "bounds": {"mode": "gaussian", "failure_probability": 0.01}
  }
}
